# =========================================
# AI Resume Analyzer + Job Matching Platform
# Safe Environment Configuration Template
# =========================================

# --- Main Backend (Express) Configuration ---
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:5173

# --- Database Configuration ---
MONGODB_URI=mongodb://localhost:27017/ai_resume_builder

# --- Authentication Configuration ---
# (Secrets should be strong random strings in production)
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_EXPIRES_IN=7d

# --- AI Service (FastAPI) Connection ---
FASTAPI_SERVICE_URL=http://ai-resume-ai-service-4xab.onrender.com

# --- Cloud & Storage (AWS S3) Configuration (Optional / Future Phases) ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
